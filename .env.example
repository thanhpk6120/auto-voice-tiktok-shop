# Cau hinh phu (override cao nhat, thang ca config.json).
# File nay TU QUAN LY - dung cho secrets (API key) va dev override.
# GUI van luu cau hinh chinh vao %APPDATA%\AutoVoiceTikTokShop\config.json.

# Server LLM (OpenAI-compatible)
LLM_BASE_URL=http://192.168.1.68:20128/v1
LLM_MODEL=claude-opus-5
LLM_API_KEY=your-api-key-here

# Model phan tich binh luan (de trong = dung luat tu khoa du phong)
ANALYST_LLM_MODEL=openrouter/typesafe/jev-1.13
